@page
@model ServiceHub.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Главная - Личный кабинет";
    Layout = "_ProfileLayout";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Главная</h1>
</div>

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">Активные заявки</h5>
                <h2 class="card-text">5</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title">Выполнено</h5>
                <h2 class="card-text">12</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h5 class="card-title">На согласовании</h5>
                <h2 class="card-text">2</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h5 class="card-title">Всего заявок</h5>
                <h2 class="card-text">19</h2>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Последние действия</h5>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    <div class="list-group-item">
                        <small class="text-muted">Сегодня, 10:30</small>
                        <p class="mb-1">Создана заявка на транспорт</p>
                    </div>
                    <div class="list-group-item">
                        <small class="text-muted">Вчера, 15:45</small>
                        <p class="mb-1">Забронирована переговорная "Альфа"</p>
                    </div>
                    <div class="list-group-item">
                        <small class="text-muted">Вчера, 12:20</small>
                        <p class="mb-1">Заказан обед в столовой</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>