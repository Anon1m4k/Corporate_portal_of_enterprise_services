@page
@model ServiceHub.Pages.Profile.HistoryModel
@{
    ViewData["Title"] = "История заявок";
    Layout = "_ProfileLayout";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">История заявок</h1>
</div>

<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-md-6">
                <select class="form-select form-select-sm">
                    <option>Все типы заявок</option>
                    <option>Транспорт</option>
                    <option>Поддержка</option>
                    <option>Питание</option>
                    <option>Помещения</option>
                </select>
            </div>
            <div class="col-md-6">
                <input type="text" class="form-control form-control-sm" placeholder="Поиск...">
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Тип</th>
                        <th>Дата создания</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>#001</td>
                        <td>🚗 Транспорт</td>
                        <td>10.01.2024 10:30</td>
                        <td><span class="badge bg-success">Выполнено</span></td>
                        <td><a href="#" class="btn btn-sm btn-outline-primary">Подробнее</a></td>
                    </tr>
                    <tr>
                        <td>#002</td>
                        <td>🛠️ Поддержка</td>
                        <td>09.01.2024 14:20</td>
                        <td><span class="badge bg-warning">В работе</span></td>
                        <td><a href="#" class="btn btn-sm btn-outline-primary">Подробнее</a></td>
                    </tr>
                    <tr>
                        <td>#003</td>
                        <td>🍽️ Питание</td>
                        <td>09.01.2024 09:15</td>
                        <td><span class="badge bg-secondary">Отменено</span></td>
                        <td><a href="#" class="btn btn-sm btn-outline-primary">Подробнее</a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>