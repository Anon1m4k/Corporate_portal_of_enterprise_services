﻿@{
Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row">
        <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
            <div class="position-sticky pt-3">
                <div class="text-center mb-4">
                    <h5>Личный кабинет</h5>
                    <small class="text-muted">@User.Identity.Name</small>
                </div>

                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Account/Dashboard">📊 Главная</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Account/Profile">👤 Профиль</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Account/History">📋 История заявок</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Account/ChangePassword">🔒 Смена пароля</a>
                    </li>
                </ul>
            </div>
        </nav>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            @RenderBody()
        </main>
    </div>
</div>

<style>
    .sidebar {
        min-height: calc(100vh - 140px);
        box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
    }

        .sidebar .nav-link {
            color: #333;
            padding: 0.75rem 1rem;
        }

            .sidebar .nav-link.active {
                color: #0d6efd;
                background-color: #e7f1ff;
            }

            .sidebar .nav-link:hover {
                background-color: #f8f9fa;
            }
</style>

@await RenderSectionAsync("Scripts", required: false)