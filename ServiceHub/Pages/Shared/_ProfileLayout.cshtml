@{
    Layout = "_Layout";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12 col-sm-5 col-md-4 col-lg-3 mb-4">
            <div class="card rounded-3 shadow-sm">
                <div class="card-body p-3">
                    <div class="text-center mb-4">
                        <i class="fas fa-user-circle fa-3x text-primary mb-2"></i>
                        <h5 class="fw-bold">@User.Identity?.Name</h5>
                        <small class="text-muted">Личный кабинет</small>
                    </div>
                    <hr />
                    <ul class="nav nav-pills flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-nowrap @(ViewContext.RouteData.Values["page"].ToString() == "/Account/Dashboard" ? "active" : "")" asp-page="/Account/Dashboard">
                                <i class="fas fa-chart-pie me-1"></i>Главная
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-nowrap @(ViewContext.RouteData.Values["page"].ToString() == "/Account/Profile" ? "active" : "")" asp-page="/Account/Profile">
                                <i class="fas fa-id-card me-1"></i>Профиль
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-nowrap @(ViewContext.RouteData.Values["page"].ToString() == "/Account/History" ? "active" : "")" asp-page="/Account/History">
                                <i class="fas fa-history me-1"></i>История заявок
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-nowrap @(ViewContext.RouteData.Values["page"].ToString() == "/Account/ChangePassword" ? "active" : "")" asp-page="/Account/ChangePassword">
                                <i class="fas fa-lock me-1"></i>Смена пароля
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <main class="col-12 col-sm-7 col-md-8 col-lg-9">
            @RenderBody()
        </main>
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)