@{
    Layout = "_Layout";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12 col-sm-5 col-md-4 col-lg-3 mb-4">
            <div class="glass-card p-3 p-sm-4">
                <div class="text-center mb-3">
                    <div class="service-icon mx-auto mb-3">
                        <i class="fas fa-user-circle fa-2x"></i>
                    </div>
                    <h5 class="fw-bold" style="color: var(--text-primary); word-break: break-word;">@User.Identity?.Name</h5>
                    <small style="color: var(--text-muted);">Личный кабинет</small>
                </div>
                <hr style="border-color: var(--glass-border);" />
                <ul class="nav flex-column profile-nav">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["page"].ToString() == "/Account/Dashboard" ? "active" : "")" asp-page="/Account/Dashboard">
                            <i class="fas fa-chart-pie me-2"></i>Главная
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["page"].ToString() == "/Account/Profile" ? "active" : "")" asp-page="/Account/Profile">
                            <i class="fas fa-id-card me-2"></i>Профиль
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["page"].ToString() == "/Account/History" ? "active" : "")" asp-page="/Account/History">
                            <i class="fas fa-history me-2"></i>История заявок
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["page"].ToString() == "/Account/ChangePassword" ? "active" : "")" asp-page="/Account/ChangePassword">
                            <i class="fas fa-lock me-2"></i>Смена пароля
                        </a>
                    </li>
                </ul>
            </div>
        </div>
        <main class="col-12 col-sm-7 col-md-8 col-lg-9">
            @RenderBody()
        </main>
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)