
@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Восстановление пароля";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4">Восстановление пароля</h2>

                    <form method="post">
                        <div class="mb-3">
                            <label for="email" class="form-label">Введите ваш Email</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Отправить ссылку для сброса</button>
                        </div>
                    </form>

                    <div class="text-center mt-3">
                        <a href="/Login" class="text-decoration-none">← Вернуться к входу</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>