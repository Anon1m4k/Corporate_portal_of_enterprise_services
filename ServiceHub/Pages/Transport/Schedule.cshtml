@page
@model ServiceHub.Pages.Transport.ScheduleModel
@{
    ViewData["Title"] = "Расписание трансфера";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="glass-title mb-1"><i class="fas fa-bus-alt me-2"></i>Регулярные маршруты</h2>
        </div>
        <a asp-page="/Transport/Index" class="btn btn-outline-glass px-4 text-nowrap">
            <i class="fas fa-arrow-left me-2"></i>Мои заявки
        </a>
    </div>


    @if (!Model.Routes.Any())
    {
        <div class="glass-card p-4 text-center">
            <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle p-3 mx-auto mb-3 opacity-25" style="width: 80px; height: 80px;">
                <i class="fas fa-calendar-times fa-2x text-muted"></i>
            </div>
            <h5 class="text-muted">Активных маршрутов не найдено</h5>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-lg-2 g-4">
            @foreach (var route in Model.Routes)
            {
                <div class="col">
                    <div class="glass-card h-100 overflow-hidden">
                        <div class="card-header p-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="fw-bold glass-title">@route.Name</h5>
                                    <span class="badge border text-muted">№@route.Id</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            @if (!string.IsNullOrEmpty(route.Description))
                            {
                                <div class="bg-light rounded-3 p-3 mb-4 border-start border-4 border-primary">
                                    <p class="small mb-0">@route.Description</p>
                                </div>
                            }

                            <p class="mb-4">
                                <i class="fas fa-shuttle-van text-primary"></i>
                                <strong>Транспорт:</strong>
                                @if (route.Car != null)
                                {
                                    <span class="text-dark">@($"{route.Car.Brand} {route.Car.Model}")</span>
                                    <span class="badge bg-info bg-opacity-10 text-primary ms-1">@route.Car.LicensePlate</span>
                                }
                                else
                                {
                                    <span class="text-muted">Не назначен</span>
                                }
                            </p>

                            <div>
                                <h6 class="fw-bold mb-3"><i class="far fa-clock me-2"></i>Остановки и время:</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-borderless align-middle table-dark-glass">
                                        <tbody>
                                            @foreach (var stop in route.Stops.OrderBy(s => s.Order))
                                            {
                                                <tr>
                                                    <td width="5%" class="text-center">
                                                        <div class="d-flex flex-column align-items-center">
                                                            <i class="fas fa-circle text-primary" style="font-size: 9px;"></i>
                                                            @if (stop != route.Stops.OrderBy(s => s.Order).Last())
                                                            {
                                                                <div class="stop-line"></div>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td class="ps-3 py-2 fw-medium">@stop.Address</td>
                                                    <td class="text-end py-2">
                                                        <span class="badge bg-primary rounded-pill">@stop.ArrivalTime.ToString(@"hh\:mm")</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>