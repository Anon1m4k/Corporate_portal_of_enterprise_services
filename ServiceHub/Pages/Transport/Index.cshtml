@page
@model ServiceHub.Pages.Transport.IndexModel
@{
    ViewData["Title"] = "Мои заявки на транспорт";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Мои заявки на транспорт</h2>
    <div>
        <a asp-page="/Transport/Schedule" class="btn btn-info me-2">
            <i class="fas fa-calendar-alt"></i> Расписание трансфера
        </a>
        <a asp-page="/Transport/Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Новая заявка
        </a>
    </div>
</div>

<!-- Форма для отчёта (POST) -->
<div class="card shadow mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">Сформировать отчёт</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Export" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Начальная дата</label>
                <input type="date" name="startDate" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Конечная дата</label>
                <input type="date" name="endDate" class="form-control" required />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-file-alt me-1"></i> Сформировать отчёт
                </button>
            </div>
        </form>
    </div>
</div>

@if (TempData["TransportSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["TransportSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow">
    <div class="card-header">
        <div class="row">
            <div class="col-md-4">
                <select class="form-select" id="statusFilter" onchange="filterByStatus(this.value)">
                    <option value="">Все статусы</option>
                    @foreach (var status in Model.AllStatuses)
                    {
                        <option value="@status" selected="@(Model.CurrentStatus == status)">@status</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Requests.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Дата и время</th>
                            <th>Маршрут</th>
                            <th>Пассажиров</th>
                            <th>Авто</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model.Requests)
                        {
                            <tr>
                                <td>#@req.Id</td>
                                <td>@req.TripDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@req.StartPoint → @req.EndPoint</td>
                                <td>@req.PassengerCount</td>
                                <td>
                                    @if (req.Car != null)
                                    {
                                        @($"{req.Car.Brand} {req.Car.Model} ({req.Car.LicensePlate})")
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @switch (req.Status)
                                    {
                                        case "На согласовании":
                                            <span class="badge bg-warning">@req.Status</span>
                                            break;
                                        case "Подтверждена":
                                            <span class="badge bg-success">@req.Status</span>
                                            break;
                                        case "Выполнена":
                                            <span class="badge bg-info">@req.Status</span>
                                            break;
                                        case "Отклонена":
                                            <span class="badge bg-danger">@req.Status</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@req.Status</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (req.Status == "На согласовании")
                                    {
                                        <button type="button" class="btn btn-square btn-outline-danger"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal-@req.Id" title="Удалить">
                                            <i class="fas fa-trash"></i>
                                        </button>

                                        <!-- Модальное окно удаления -->
                                        <div class="modal fade" id="deleteModal-@req.Id" tabindex="-1" aria-labelledby="deleteModalLabel-@req.Id" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="deleteModalLabel-@req.Id">Подтверждение удаления</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        Вы уверены, что хотите удалить заявку на поездку <strong>@req.TripDateTime.ToString("dd.MM.yyyy HH:mm")</strong>?
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                                                        <form method="post" asp-page-handler="Delete" asp-route-id="@req.Id">
                                                            <button type="submit" class="btn btn-danger">Удалить</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">У вас пока нет заявок на транспорт.</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        function filterByStatus(status) {
            var url = new URL(window.location.href);
            if (status) {
                url.searchParams.set('status', status);
            } else {
                url.searchParams.delete('status');
            }
            window.location.href = url.toString();
        }
    </script>
}