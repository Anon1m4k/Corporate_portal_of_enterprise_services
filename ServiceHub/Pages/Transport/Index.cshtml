@page
@model ServiceHub.Pages.Transport.IndexModel
@{
    ViewData["Title"] = "Мои заявки на транспорт";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="glass-title mb-1">Мои заявки на транспорт</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Transport/Create" class="btn btn-glass px-3 shadow-sm">
                <i class="fas fa-plus me-2"></i>Новая заявка
            </a>
            <a asp-page="/Transport/Schedule" class="btn btn-outline-glass px-3">
                <i class="fas fa-calendar-alt me-2"></i>Расписание
            </a>           
        </div>
    </div>

    <!-- Блок формирования отчёта -->
    <div class="glass-container p-4 mb-4">
        <h5 class="mb-3 fw-bold">Сформировать отчёт</h5>
        <form method="get" asp-page="/Transport/Report" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-medium">Начальная дата</label>
                <input type="date" name="startDate" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-medium">Конечная дата</label>
                <input type="date" name="endDate" class="form-control" required />
            </div>
            <div class="col-md-4 d-flex justify-content-center align-items-end">
                <button type="submit" class="btn btn-glass px-4 shadow-sm text-nowrap">
                    <i class="fas fa-file-excel me-2"></i>Сформировать
                </button>
            </div>
        </form>
    </div>

    @if (TempData["TransportSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 glass-container mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle me-2"></i>
                <div>@TempData["TransportSuccess"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Карточки заявок -->
    <div class="glass-container p-2">
        @if (Model.Requests.Any())
        {
            <div class="row g-3">
                @foreach (var req in Model.Requests)
                {
                    <div class="col-12 col-md-6 col-lg-6">
                        <div class="glass-card p-4 h-100 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 class="fw-bold mb-3">№@req.Id</h6>
<div class="small text-muted mt-1">
    <i class="far fa-calendar-alt me-1"></i> @req.TripDateTime.ToString("dd.MM.yyyy")
</div>
                                    <div class="small text-muted">
                                        <i class="far fa-clock me-1"></i> @req.TripDateTime.ToString("HH:mm")
                                    </div>
                                </div>
                                <span class="badge badge-glass @(req.Status == "На согласовании" ? "bg-warning text-dark" : req.Status == "Подтверждена" ? "bg-success" : req.Status == "Завершена" ? "bg-info text-dark" : req.Status == "Отклонена" ? "bg-danger" : "bg-secondary")">
                                    @req.Status
                                </span>
                            </div>

                            <div class="mb-2 small">
                                <i class="fas fa-map-marker-alt me-1"></i> @req.StartPoint → @req.EndPoint
                            </div>
                            <div class="mb-2 small">
                                <strong>Цель:</strong> @req.Purpose
                            </div>
                            <div class="mb-2 small">
                                <strong>Пассажиров:</strong> @req.PassengerCount
                            </div>
                            <div class="mb-2 small">
                                <strong>Автомобиль:</strong>
                                @if (req.Car != null)
                                {
                                    @req.Car.Brand @req.Car.Model <span class="text-muted">(@req.Car.LicensePlate)</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Будет назначен</span>
                                }
                            </div>

                            <div class="d-flex justify-content-end gap-1 mt-auto">
                                @if (req.Status == "На согласовании")
                                {
                                    <button type="button" class="btn btn-sm btn-danger" title="Отменить"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal-@req.Id">
                                        <i class="fas fa-trash me-2"></i>Отменить
                                    </button>
                                }
                                @if (req.Status == "Подтверждена")
                                {
                                    <form method="post" asp-page-handler="Complete" asp-route-id="@req.Id">
                                        <button type="submit" class="btn btn-glass px-3 shadow-sm" title="Завершить">
                                            <i class="fas fa-check me-2"></i>Завершить
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-map-marked-alt fa-3x text-muted opacity-25 mb-3"></i>
                <p class="text-muted fw-bold">Список заявок пуст</p>
                <a asp-page="/Transport/Create" class="btn btn-glass mt-2">Оформить первую поездку</a>
            </div>
        }
    </div>
</div>

<!-- Модальные окна вынесены за пределы карточек -->
@foreach (var req in Model.Requests)
{
    @if (req.Status == "На согласовании")
    {
        <div class="modal fade modal-glass" id="deleteModal-@req.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header border-0 pb-0">
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center p-4">
                        <i class="fas fa-exclamation-circle fa-3x text-danger mb-3"></i>
                        <h5 class="fw-bold mb-3">Отменить заявку?</h5>
                        <p class="text-muted">Вы действительно хотите отменить заявку?</p>
                    </div>
                    <div class="modal-footer border-0 justify-content-center pb-4">
                        <button type="button" class="btn btn-outline-glass px-4" data-bs-dismiss="modal">Нет, оставить</button>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@req.Id">
                            <button type="submit" class="btn btn-danger px-4">Да, отменить</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        function filterByStatus(status) {
            var url = new URL(window.location.href);
            if (status) { url.searchParams.set('status', status); }
            else { url.searchParams.delete('status'); }
            window.location.href = url.toString();
        }
    </script>
}