@page
@model ServiceHub.Pages.Transport.IndexModel
@{
    ViewData["Title"] = "Мои заявки на транспорт";
}

<div class="container mt-4 fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="section-title mb-1">Мои заявки на транспорт</h2>
            <p class="text-muted mb-0">Управление вашими запросами на поездки</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Transport/Schedule" class="btn btn-outline-primary rounded-pill px-4">
                <i class="fas fa-calendar-alt me-2"></i>Расписание
            </a>
            <a asp-page="/Transport/Create" class="btn btn-primary rounded-pill px-4 shadow-lg">
                <i class="fas fa-plus me-2"></i>Новая заявка
            </a>
        </div>
    </div>

    <!-- Блок фильтрации и отчетов -->
    <div class="card bg-white shadow-xl rounded-4 mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h5 class="mb-0">Сформировать отчёт</h5>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-page-handler="Export" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Начальная дата</label>
                    <input type="date" name="startDate" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Конечная дата</label>
                    <input type="date" name="endDate" class="form-control" required />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill shadow-lg">
                        <i class="fas fa-file-excel me-2"></i>Сформировать
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["TransportSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-lg rounded-4 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <div class="bg-white rounded-circle p-2 text-success me-3 shadow-sm">
                    <i class="fas fa-check"></i>
                </div>
                <div>@TempData["TransportSuccess"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Таблица заявок -->
    <div class="card border-0 shadow-xl rounded-4 overflow-hidden">
        <div class="card-body p-0">
            @if (Model.Requests.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Дата и время</th>
                                <th>Маршрут</th>
                                <th>Пассажиров</th>
                                <th>Автомобиль</th>
                                <th>Статус</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in Model.Requests)
                            {
                                <tr>
                                    <td class="ps-4 text-muted small">#@req.Id</td>
                                    <td>
                                        <div class="fw-bold">@req.TripDateTime.ToString("dd.MM.yyyy")</div>
                                        <div class="small text-primary">@req.TripDateTime.ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="text-dark">@req.StartPoint</span>
                                            <i class="fas fa-long-arrow-alt-right mx-2 text-muted"></i>
                                            <span class="text-dark">@req.EndPoint</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                                            <i class="fas fa-users me-1"></i> @req.PassengerCount
                                        </span>
                                    </td>
                                    <td>
                                        @if (req.Car != null)
                                        {
                                            <div class="fw-medium">@req.Car.Brand @req.Car.Model</div>
                                            <div class="badge bg-light text-dark border small">@req.Car.LicensePlate</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted italic small">Будет назначен</span>
                                        }
                                    </td>
                                    <td>
                                        @switch (req.Status)
                                        {
                                            case "На согласовании":
                                                <span class="badge bg-warning text-dark"><i class="fas fa-spinner fa-spin me-1"></i> @req.Status</span>
                                                break;
                                            case "Подтверждена":

                                                <span class="badge bg-success"><i class="fas fa-check-double me-1"></i> @req.Status</span>
                                                break;
                                            case "Выполнена":

                                                <span class="badge bg-info"><i class="fas fa-flag-checkered me-1"></i> @req.Status</span>
                                                break;
                                            case "Отклонена":

                                                <span class="badge bg-danger"><i class="fas fa-times me-1"></i> @req.Status</span>
                                                break;
                                            default:

                                                <span class="badge bg-secondary">@req.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (req.Status == "На согласовании")
                                        {
                                            <button type="button" class="btn btn-square btn-outline-danger"
                                                    data-bs-toggle="modal" data-bs-target="#deleteModal-@req.Id" title="Отменить">
                                                <i class="fas fa-trash"></i>
                                            </button>

                                            <!-- Модальное окно -->
                                            <div class="modal fade" id="deleteModal-@req.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content border-0 shadow-lg rounded-4">
                                                        <div class="modal-header border-0 pb-0">
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body text-center p-4">
                                                            <div class="icon-box bg-danger bg-opacity-10 text-danger mx-auto mb-3">
                                                                <i class="fas fa-exclamation-circle fa-2x"></i>
                                                            </div>
                                                            <h5 class="fw-bold mb-3">Отменить заявку?</h5>
                                                            <p class="text-muted">Вы действительно хотите удалить заявку на поездку от <strong>@req.TripDateTime.ToString("dd.MM HH:mm")</strong>?</p>
                                                        </div>
                                                        <div class="modal-footer border-0 justify-content-center pb-4">
                                                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Нет, оставить</button>
                                                            <form method="post" asp-page-handler="Delete" asp-route-id="@req.Id">
                                                                <button type="submit" class="btn btn-danger rounded-pill px-4">Да, отменить</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        @if (req.Status == "Подтверждена")
                                        {
                                            <form method="post" asp-page-handler="Complete" asp-route-id="@req.Id" class="d-inline">
                                                <button type="submit" class="btn btn-square btn-success" title="Завершить">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="icon-box mx-auto mb-3 opacity-25">
                        <i class="fas fa-map-marked-alt"></i>
                    </div>
                    <p class="text-muted fw-bold">Список заявок пуст</p>
                    <a asp-page="/Transport/Create" class="btn btn-primary rounded-pill mt-2">Оформить первую поездку</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterByStatus(status) {
            var url = new URL(window.location.href);
            if (status) { url.searchParams.set('status', status); }
            else { url.searchParams.delete('status'); }
            window.location.href = url.toString();
        }
    </script>
}