@page
@model ServiceHub.Pages.Transport.IndexModel
@{
    ViewData["Title"] = "Мои заявки на транспорт";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-primary mb-1">Мои заявки на транспорт</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Transport/Schedule" class="btn btn-outline-primary rounded-pill px-4">
                <i class="fas fa-calendar-alt me-2"></i>Расписание
            </a>
            <a asp-page="/Transport/Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="fas fa-plus me-2"></i>Новая заявка
            </a>
        </div>
    </div>

    <!-- Блок фильтрации и отчетов -->
    <div class="card bg-white shadow-sm rounded-3 mb-4">
        <div class="card-header">
            <h5 class="mb-0">Сформировать отчёт</h5>
        </div>
        <div class="card-body p-3">
            <form method="post" asp-page-handler="Export" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Начальная дата</label>
                    <input type="date" name="startDate" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Конечная дата</label>
                    <input type="date" name="endDate" class="form-control" required />
                </div>
                <div class="col-md-4 d-flex justify-content-center align-items-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm text-nowrap">
                        <i class="fas fa-file-excel me-2"></i>Сформировать
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["TransportSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle me-2"></i>
                <div>@TempData["TransportSuccess"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Таблица заявок -->
    <div class="card shadow-lg rounded-3">
        <div class="card-body p-2">
            @if (Model.Requests.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle text-center">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 align-middle">ID</th>                     
                                <th class="align-middle">Дата и время</th>
                                <th class="align-middle">Маршрут</th>
                                <th class="align-middle">Пассажиров</th>
                                <th class="align-middle">Автомобиль</th>
                                <th class="align-middle">Статус</th>
                                <th class="align-middle">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in Model.Requests)
                            {
                                <tr>
                                    <td>@req.Id</td>
                                    <td>
                                        <div>@req.TripDateTime.ToString("dd.MM.yyyy")</div>
                                        <div class="small text-primary">@req.TripDateTime.ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center justify-content-center">
                                            <span>@req.StartPoint</span>
                                            <i class="fas fa-long-arrow-alt-right mx-2 text-muted"></i>
                                            <span>@req.EndPoint</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                                            <i class="fas fa-users me-1"></i> @req.PassengerCount
                                        </span>
                                    </td>
                                    <td>
                                        @if (req.Car != null)
                                        {
                                            <div>@req.Car.Brand @req.Car.Model</div>
                                            <div class="small text-muted">@req.Car.LicensePlate</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic small">Будет назначен</span>
                                        }
                                    </td>
                                    <td>
                                        @switch (req.Status)
                                        {
                                            case "На согласовании":
                                                <span class="badge bg-warning text-dark"> @req.Status</span>
                                                break;
                                            case "Подтверждена":
                                                <span class="badge bg-success"> @req.Status</span>
                                                break;
                                            case "Выполнена":
                                                <span class="badge bg-info text-dark"> @req.Status</span>
                                                break;
                                            case "Отклонена":
                                                <span class="badge bg-danger"> @req.Status</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@req.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (req.Status == "На согласовании")
                                        {
                                            <button type="button" class="btn btn-sm btn-danger" style="width: 42px; height: 42px; padding: 0; display: inline-flex; align-items: center; justify-content: center;"
                                                    data-bs-toggle="modal" data-bs-target="#deleteModal-@req.Id" title="Отменить">
                                                <i class="fas fa-trash"></i>
                                            </button>

                                            <div class="modal fade" id="deleteModal-@req.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content border-0 shadow-lg rounded-3">
                                                        <div class="modal-header border-0 pb-0">
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body text-center p-4">
                                                            <i class="fas fa-exclamation-circle fa-3x text-danger mb-3"></i>
                                                            <h5 class="fw-bold mb-3">Отменить заявку?</h5>
                                                            <p class="text-muted">Вы действительно хотите отменить заявку?</p>
                                                        </div>
                                                        <div class="modal-footer border-0 justify-content-center pb-4">
                                                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Нет, оставить</button>
                                                            <form method="post" asp-page-handler="Delete" asp-route-id="@req.Id">
                                                                <button type="submit" class="btn btn-danger rounded-pill px-4">Да, отменить</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        @if (req.Status == "Подтверждена")
                                        {
                                            <form method="post" asp-page-handler="Complete" asp-route-id="@req.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success" style="width: 42px; height: 42px; padding: 0; display: inline-flex; align-items: center; justify-content: center;" title="Завершить">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-map-marked-alt fa-3x text-muted opacity-25 mb-3"></i>
                    <p class="text-muted fw-bold">Список заявок пуст</p>
                    <a asp-page="/Transport/Create" class="btn btn-primary rounded-pill mt-2">Оформить первую поездку</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterByStatus(status) {
            var url = new URL(window.location.href);
            if (status) { url.searchParams.set('status', status); }
            else { url.searchParams.delete('status'); }
            window.location.href = url.toString();
        }
    </script>
}