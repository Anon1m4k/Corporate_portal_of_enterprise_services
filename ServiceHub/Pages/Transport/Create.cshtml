@page
@model ServiceHub.Pages.Transport.CreateModel
@{
    ViewData["Title"] = "Новая заявка на транспорт";
}

<div class="container mt-4">
    <div class="card border-0 shadow">
        <div class="card-body p-4">
            <h2 class="mb-4">Заказ транспорта</h2>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.TripType" class="form-label"></label>
                        <select asp-for="Input.TripType" class="form-select" asp-items="Model.TripTypeOptions"></select>
                        <span asp-validation-for="Input.TripType" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.VehicleType" class="form-label"></label>
                        <select asp-for="Input.VehicleType" class="form-select" asp-items="Model.VehicleTypeOptions"></select>
                        <span asp-validation-for="Input.VehicleType" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.TripDateTime" class="form-label"></label>
                        <input asp-for="Input.TripDateTime" class="form-control" type="datetime-local" />
                        <span asp-validation-for="Input.TripDateTime" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.PassengerCount" class="form-label"></label>
                        <input asp-for="Input.PassengerCount" class="form-control" type="number" min="1" />
                        <span asp-validation-for="Input.PassengerCount" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.StartPoint" class="form-label"></label>
                        <input asp-for="Input.StartPoint" class="form-control" />
                        <span asp-validation-for="Input.StartPoint" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.EndPoint" class="form-label"></label>
                        <input asp-for="Input.EndPoint" class="form-control" />
                        <span asp-validation-for="Input.EndPoint" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Purpose" class="form-label"></label>
                    <textarea asp-for="Input.Purpose" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Input.Purpose" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.VehicleModel" class="form-label"></label>
                    <input asp-for="Input.VehicleModel" class="form-control" />
                    <span asp-validation-for="Input.VehicleModel" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Отправить заявку</button>
                <a asp-page="/Transport/Index" class="btn btn-secondary">Отмена</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}