@page
@model ServiceHub.Pages.Transport.CreateModel
@{
    ViewData["Title"] = "Новая заявка на транспорт";
}

<div class="container mt-4">
    <div class="card border-0 shadow">
        <div class="card-body p-4">
            <h2 class="mb-4">Служебная поездка</h2>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="TransportRequest.TripDateTime" class="form-label"></label>
                        <input asp-for="TransportRequest.TripDateTime" class="form-control" type="datetime-local" />
                        <span asp-validation-for="TransportRequest.TripDateTime" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="TransportRequest.PassengerCount" class="form-label"></label>
                        <input asp-for="TransportRequest.PassengerCount" class="form-control" type="number" />
                        <span asp-validation-for="TransportRequest.PassengerCount" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="TransportRequest.StartPoint" class="form-label"></label>
                        <input asp-for="TransportRequest.StartPoint" class="form-control" />
                        <span asp-validation-for="TransportRequest.StartPoint" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="TransportRequest.EndPoint" class="form-label"></label>
                        <input asp-for="TransportRequest.EndPoint" class="form-control" />
                        <span asp-validation-for="TransportRequest.EndPoint" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="TransportRequest.Purpose" class="form-label"></label>
                    <textarea asp-for="TransportRequest.Purpose" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="TransportRequest.Purpose" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TransportRequest.CarId" class="form-label"></label>
                    <select asp-for="TransportRequest.CarId" class="form-select" asp-items="Model.CarOptions">
                        <option value="">-- Выберите автомобиль --</option>
                    </select>
                    <span asp-validation-for="TransportRequest.CarId" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Отправить заявку</button>
                <a asp-page="/Transport/Index" class="btn btn-secondary">Отмена</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}