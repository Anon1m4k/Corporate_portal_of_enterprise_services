@page
@model ErrorModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="container mt-5 text-center fade-in">
    <div class="display-1 text-muted mb-4">
        <i class="fas fa-exclamation-triangle text-warning"></i>
    </div>
    <h1 class="display-4">Ошибка</h1>
    <p class="lead text-muted mt-3">При обработке запроса произошла ошибка.</p>
    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code class="bg-light p-1 rounded">@Model.RequestId</code>
        </p>
    }
    <a asp-page="/Index" class="btn btn-primary btn-lg mt-4 rounded-pill px-5">
        <i class="fas fa-home me-2"></i>На главную
    </a>
</div>