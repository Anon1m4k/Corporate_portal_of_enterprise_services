@page
@model ServiceHub.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Управление пользователями";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary">Управление персоналом</h2>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-lg rounded-3 mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var user in Model.Users)
        {
            <div class="col">
                <div class="card h-100 shadow-lg rounded-3 user-card overflow-hidden">
                    <div class="card-body p-4 text-center">
                        <div class="mx-auto mb-3" style="width: 80px;">
                            <div class="bg-primary bg-opacity-50 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                <span class="h3 mb-0 fw-bold">@user.FirstName[0]@user.LastName[0]</span>
                            </div>
                        </div>
                        <h5 class="fw-bold mb-1 text-dark">@user.FirstName @user.LastName</h5>
                        <div class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 mb-3">
                            @GetRoleDisplay(user.Role)
                        </div>
                        <div class="bg-light rounded-3 p-3 text-start mb-4">
                            <div class="mb-2 small">
                                <i class="fas fa-envelope text-muted me-2"></i> @user.Email
                            </div>
                            <div class="small">
                                <i class="fas fa-building text-muted me-2"></i> @user.Department
                            </div>
                        </div>

                        <div class="d-flex justify-content-center gap-2">
                            <a asp-page="/Account/Profile" asp-route-id="@user.Id"
                               class="btn btn-sm btn-primary" style="width: 42px; height: 42px; padding: 0; display: inline-flex; align-items: center; justify-content: center;" title="Редактировать">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-page="/Admin/ChangeUserPassword" asp-route-id="@user.Id"
                               class="btn btn-sm btn-warning" style="width: 42px; height: 42px; padding: 0; display: inline-flex; align-items: center; justify-content: center;" title="Сменить пароль">
                                <i class="fas fa-key"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-danger" style="width: 42px; height: 42px; padding: 0; display: inline-flex; align-items: center; justify-content: center;" title="Удалить"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal-@user.Id">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Удаления -->
            <div class="modal fade" id="deleteModal-@user.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg rounded-3">
                        <div class="modal-header border-0 pb-0">
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body text-center p-4">
                            <i class="fas fa-exclamation-circle fa-3x text-danger mb-3"></i>
                            <h5 class="fw-bold mb-3 text-danger">Удалить сотрудника?</h5>
                            <p class="text-muted">Вы действительно хотите удалить сотрудника?</p>
                        </div>
                        <div class="modal-footer border-0 justify-content-center pb-4">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Нет, оставить</button>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id">
                                <button type="submit" class="btn btn-danger rounded-pill px-4">Да, удалить</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>        
        }
    </div>
</div>