@page
@model ServiceHub.Pages.Admin.ReportModel
@{
    ViewData["Title"] = "Предпросмотр сводного отчёта";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="glass-title">Предпросмотр сводного отчёта по заявкам</h2>
    </div>

    <div class="glass-container p-3">
        <p><strong>Период:</strong> @Model.StartDate.ToString("dd.MM.yyyy") – @Model.EndDate.ToString("dd.MM.yyyy")</p>
        <p><strong>Пользователь:</strong> @Model.UserName</p>
        <p><strong>Сформирован:</strong> @Model.GeneratedAt.ToString("dd.MM.yyyy HH:mm")</p>

        <div class="table-responsive">
            <table class="table table-hover table-report align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th>№</th>
                    <th>Тип</th>
                    <th>Автор</th>
                    <th>Заголовок / Маршрут</th>
                    <th>Детали</th>
                    <th>Дата создания</th>
                    <th>Статус</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 1;
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@index</td>
                        <td>@item.Type</td>
                        <td>@item.UserName</td>
                        <td>@item.Title</td>
                        <td>@item.Details</td>
                        <td>@item.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>
                            @switch (item.Status)
                            {
                                case "На согласовании":
                                        <span class="badge badge-glass bg-warning text-dark">@item.Status</span>
                                    break;
                                case "Подтверждена":
                                        <span class="badge badge-glass bg-success">@item.Status</span>
                                    break;
                                case "Выполнена":
                                case "Завершена":
                                        <span class="badge badge-glass bg-info text-dark">@item.Status</span>
                                    break;
                                case "Отклонена":
                                        <span class="badge badge-glass bg-danger">@item.Status</span>
                                    break;
                                default:
                                        <span class="badge badge-glass bg-secondary">@item.Status</span>
                                    break;
                            }
                        </td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>
        </div>

        <!-- Итоги -->
        @{
            int confirmed = Model.Items.Count(i => i.Status == "Подтверждена");
            int completed = Model.Items.Count(i => i.Status == "Выполнена" || i.Status == "Завершена");
            int rejected = Model.Items.Count(i => i.Status == "Отклонена");
            int pending = Model.Items.Count(i => i.Status == "На согласовании");
        }
        <div class="mt-3">
            <p><strong>Итого заявок: @Model.Items.Count</strong></p>
            <p>Подтверждено: @confirmed | Выполнено/Завершено: @completed | Отклонено: @rejected | На согласовании: @pending</p>
        </div>

        <div class="d-flex gap-2 mt-4">
            <form method="post" asp-page-handler="Download">
                <input type="hidden" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="status" value="@Model.FilterStatus" />
                <button type="submit" class="btn btn-glass px-4">
                    <i class="fas fa-save me-2"></i>Сохранить в Excel
                </button>
            </form>
            <a asp-page="/Admin/ServiceRequests" class="btn btn-outline-glass px-4">
                <i class="fas fa-times me-2"></i>Отмена
            </a>
        </div>
    </div>
</div>