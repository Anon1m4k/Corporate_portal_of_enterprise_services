@page
@model ServiceHub.Pages.Admin.Rooms.IndexModel
@{
    ViewData["Title"] = "Управление помещениями";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="glass-title">Помещения</h2>
        <a asp-page="Create" class="btn btn-glass px-4">
            <i class="fas fa-plus me-2"></i>Добавить помещение
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="glass-container p-3">
        @if (Model.Rooms.Any())
        {
            <div class="row g-3">
                @foreach (var room in Model.Rooms)
                {
                    <div class="col-12 col-md-6">
                        <div class="glass-card p-4 h-100">
                            <h6 class="fw-bold mb-2">@room.Name</h6>
                            <div class="small text-muted mb-3">
                                <i class="fas fa-map-marker-alt me-1"></i> @room.Location
                            </div>
                            <div class="mb-2 small">
                                <strong>Вместимость:</strong> @room.Capacity чел.
                            </div>
                            <div class="mb-3 small">
                                <strong>Оснащение:</strong> @(string.IsNullOrEmpty(room.Equipment) ? "—" : room.Equipment)
                            </div>

                            <div class="d-flex align-items-center mb-3">
                                <form method="post" asp-page-handler="ToggleActive" asp-route-id="@room.Id" class="d-flex align-items-center">
                                    <div class="form-check form-switch me-2">
                                        <input class="form-check-input" type="checkbox"
                                               id="active-@room.Id"
                                               name="isActive" value="true"
                                               @(room.IsActive ? "checked" : "")
                                               onchange="this.form.submit()">
                                        <label class="form-check-label small" for="active-@room.Id">
                                            @(room.IsActive ? "Активно" : "Не активно")
                                        </label>
                                    </div>
                                </form>
                            </div>

                            <div class="d-flex justify-content-end gap-1 mt-auto">
                                <button type="button" class="btn btn-sm btn-danger" title="Удалить"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal-@room.Id">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>

                            <!-- Модальное окно удаления -->
                            <div class="modal fade modal-glass" id="deleteModal-@room.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header border-0 pb-0">
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body text-center p-4">
                                            <i class="fas fa-exclamation-circle fa-3x text-danger mb-3"></i>
                                            <h5 class="fw-bold mb-3">Удалить помещение?</h5>
                                            <p class="text-muted">Вы действительно хотите удалить помещение?</p>
                                        </div>
                                        <div class="modal-footer border-0 justify-content-center pb-4">
                                            <button type="button" class="btn btn-outline-glass px-4" data-bs-dismiss="modal">Нет, оставить</button>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@room.Id">
                                                <button type="submit" class="btn btn-glass px-4">Да, удалить</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted">Нет помещений.</p>
                <a asp-page="Create" class="btn btn-glass mt-2">
                    <i class="fas fa-plus me-2"></i>Добавить первое помещение
                </a>
            </div>
        }
    </div>
</div>