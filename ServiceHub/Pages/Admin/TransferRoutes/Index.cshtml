@page
@model ServiceHub.Pages.Admin.TransferRoutes.IndexModel
@{
    ViewData["Title"] = "Маршруты трансфера";
}



<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Маршруты для автомобиля @Model.CarName</h2>

        <a asp-page="/Admin/Cars/Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Назад к автомобилям
        </a>

    @if (Model.CanAddRoute)
    {
        <a asp-page="Create" asp-route-carId="@Model.CarId" class="btn btn-primary">
            <i class="fas fa-plus"></i> Добавить маршрут
        </a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow">
    <div class="card-body">
        @if (Model.Routes.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Описание</th>
                            <th>Остановок</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var route in Model.Routes)
                        {
                            <tr>
                                <td>@route.Name</td>
                                <td>@(route.Description ?? "—")</td>
                                <td>@route.Stops.Count</td>
                                <td>
                                    <form method="post" asp-page-handler="ToggleActive" style="display:inline;">
                                        <input type="hidden" name="id" value="@route.Id" />
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch"
                                                   id="active-@route.Id"
                                                   name="isActive"
                                                   value="true"
                                                   @(route.IsActive ? "checked" : "")
                                                   onchange="this.form.submit()">
                                            <label class="form-check-label" for="active-@route.Id">
                                                @(route.IsActive ? "Активен" : "Неактивен")
                                            </label>
                                        </div>
                                    </form>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-info" title="Подробнее"
                                            data-bs-toggle="modal" data-bs-target="#detailsModal-@route.Id">
                                        <i class="fas fa-info-circle"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal-@route.Id">
                                        <i class="fas fa-trash"></i>
                                    </button>

                                    <!-- Модальное окно просмотра деталей -->
                                    <div class="modal fade" id="detailsModal-@route.Id" tabindex="-1" aria-labelledby="detailsModalLabel-@route.Id" aria-hidden="true">
                                        <div class="modal-dialog modal-lg">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="detailsModalLabel-@route.Id">@route.Name</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    @if (!string.IsNullOrEmpty(route.Description))
                                                    {
                                                        <p><strong>Описание:</strong> @route.Description</p>
                                                    }
                                                    <p>
                                                        <strong>Автомобиль:</strong>
                                                        @if (route.Car != null)
                                                        {
                                                            @($"{route.Car.Brand} {route.Car.Model} ({route.Car.LicensePlate})")
                                                        }
                                                        else
                                                        {
                                                            <span>Не указан</span>
                                                        }
                                                    </p>
                                                    <p><strong>Статус:</strong> @(route.IsActive ? "Активен" : "Неактивен")</p>
                                                    <h6 class="mt-3">Остановки</h6>
                                                    <table class="table table-sm table-bordered">
                                                        <thead>
                                                            <tr>
                                                                <th>№</th>
                                                                <th>Адрес</th>
                                                                <th>Время прибытия</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var stop in route.Stops.OrderBy(s => s.Order))
                                                            {
                                                                <tr>
                                                                    <td>@stop.Order</td>
                                                                    <td>@stop.Address</td>
                                                                    <td>@stop.ArrivalTime.ToString(@"hh\:mm")</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Модальное окно подтверждения удаления -->
                                    <div class="modal fade" id="deleteModal-@route.Id" tabindex="-1" aria-labelledby="deleteModalLabel-@route.Id" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="deleteModalLabel-@route.Id">Подтверждение удаления</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Вы уверены, что хотите удалить маршрут <strong>@route.Name</strong>?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                                                    <form method="post" asp-page-handler="Delete" asp-route-id="@route.Id">
                                                        <button type="submit" class="btn btn-danger">Удалить</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">Для этого автомобиля пока нет маршрутов.</p>
        }
    </div>
</div>