@page
@model ServiceHub.Pages.Admin.ChangeUserPasswordModel
@{
    ViewData["Title"] = "Смена пароля пользователя";
}

<div class="container mt-4">
    <div class="card border-0 shadow">
        <div class="card-body p-4">
            <h2 class="mb-4">Смена пароля для пользователя @Model.User?.Email</h2>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post">
                <input type="hidden" asp-for="UserId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">Новый пароль</label>
                    <input asp-for="NewPassword" type="password" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                    <div class="form-text">Пароль должен содержать не менее 8 символов</div>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Подтверждение пароля</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Сменить пароль</button>
                <a asp-page="/Admin/Users" class="btn btn-secondary">Отмена</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}