@page
@model ServiceHub.Pages.Admin.ChangeUserPasswordModel
@{
    ViewData["Title"] = "Смена пароля пользователя";
}

<div class="container mt-4 fade-in">
    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <h2 class="section-title mb-0">Смена пароля для <span class="text-primary">@Model.User?.Email</span></h2>
        </div>
        <div class="card-body p-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post">
                <input type="hidden" asp-for="UserId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-medium">Новый пароль</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-key text-primary"></i></span>
                        <input asp-for="NewPassword" type="password" class="form-control rounded-3" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                    <div class="form-text">Пароль должен содержать не менее 8 символов</div>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-medium">Подтверждение пароля</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-key text-primary"></i></span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control rounded-3" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="fas fa-save me-2"></i>Сменить пароль
                    </button>
                    <a asp-page="/Admin/Users" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fas fa-times me-2"></i>Отмена
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}