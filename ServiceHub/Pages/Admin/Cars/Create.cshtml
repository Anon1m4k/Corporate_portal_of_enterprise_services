@page
@model ServiceHub.Pages.Admin.Cars.CreateModel
@{
    ViewData["Title"] = "Добавление автомобиля";
}

<div class="container mt-4 fade-in">
    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <h2 class="section-title mb-0">Добавление автомобиля</h2>
        </div>
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Car.Brand" class="form-label fw-medium"></label>
                        <input asp-for="Car.Brand" class="form-control rounded-3" placeholder="Марка" />
                        <span asp-validation-for="Car.Brand" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Car.Model" class="form-label fw-medium"></label>
                        <input asp-for="Car.Model" class="form-control rounded-3" placeholder="Модель" />
                        <span asp-validation-for="Car.Model" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Car.LicensePlate" class="form-label fw-medium"></label>
                        <input asp-for="Car.LicensePlate" class="form-control rounded-3" placeholder="А123ВС777" />
                        <span asp-validation-for="Car.LicensePlate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Car.VehicleType" class="form-label fw-medium"></label>
                        <select asp-for="Car.VehicleType" class="form-select rounded-3">
                            <option value="">-- Выберите тип --</option>
                            <option value="Легковой">Легковой</option>
                            <option value="Минивэн">Минивэн</option>
                            <option value="Автобус">Автобус</option>
                            <option value="Грузовой">Грузовой</option>
                        </select>
                        <span asp-validation-for="Car.VehicleType" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Car.PassengerCapacity" class="form-label fw-medium"></label>
                        <input asp-for="Car.PassengerCapacity" class="form-control rounded-3" type="number" min="1" max="30" />
                        <span asp-validation-for="Car.PassengerCapacity" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-check mt-4 pt-2">
                            <input asp-for="Car.IsAvailable" class="form-check-input" />
                            <label asp-for="Car.IsAvailable" class="form-check-label fw-medium"></label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="fas fa-save me-2"></i>Сохранить
                    </button>
                    <a asp-page="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fas fa-times me-2"></i>Отмена
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}