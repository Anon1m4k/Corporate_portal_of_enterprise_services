@page
@model ServiceHub.Pages.Admin.Cars.IndexModel
@{
    ViewData["Title"] = "Управление автомобилями";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="glass-title">Автомобили</h2>
        <a asp-page="Create" class="btn btn-glass px-4">
            <i class="fas fa-plus me-2"></i>Добавить автомобиль
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="glass-container p-3">
        @if (Model.Cars.Any())
        {
            <div class="row g-3">
                @foreach (var car in Model.Cars)
                {
                    <div class="col-12 col-md-6">
                        <div class="glass-card p-4 h-100">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 class="fw-bold mb-1">@car.Brand @car.Model</h6>
                                    <span class="badge badge-glass bg-light text-dark border">@car.LicensePlate</span>
                                </div>
                                <span class="badge badge-glass bg-secondary bg-opacity-10 text-secondary border">
                                    <i class="fas fa-users me-1"></i> @(car.PassengerCapacity?.ToString() ?? "—")
                                </span>
                            </div>

                            <div class="mb-3 small">
                                <strong>Тип:</strong> @car.VehicleType
                            </div>

                            <div class="mb-3 d-flex align-items-center">
                                <form method="post" asp-page-handler="ToggleAvailability" class="d-flex align-items-center">
                                    <input type="hidden" name="id" value="@car.Id" />
                                    <div class="form-check form-switch me-2">
                                        <input class="form-check-input" type="checkbox" role="switch"
                                               id="available-@car.Id"
                                               name="isAvailable" value="true"
                                               @(car.IsAvailable ? "checked" : "")
                                               onchange="this.form.submit()">
                                        <label class="form-check-label small" for="available-@car.Id">
                                            @(car.IsAvailable ? "Доступен" : "Занят")
                                        </label>
                                    </div>
                                </form>
                            </div>

                            <div class="d-flex justify-content-end gap-1 mt-auto">
                                @if (car.VehicleType == "Минивэн" || car.VehicleType == "Автобус")
                                {
                                    <a asp-page="/Admin/TransferRoutes/Index" asp-route-carId="@car.Id"
                                       class="btn btn-sm btn-glass" title="Маршруты">
                                        <i class="fas fa-route"></i>
                                    </a>
                                }
                                <button type="button" class="btn btn-sm btn-danger" title="Удалить"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal-@car.Id">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>

                            <!-- Модальное окно удаления -->
                            <div class="modal fade modal-glass" id="deleteModal-@car.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <div class="modal-header border-0 pb-0">
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body text-center p-4">
                                            <i class="fas fa-exclamation-circle fa-3x text-danger mb-3"></i>
                                            <h5 class="fw-bold mb-3">Удалить автомобиль?</h5>
                                            <p class="text-muted">Вы действительно хотите удалить автомобиль?</p>
                                        </div>
                                        <div class="modal-footer border-0 justify-content-center pb-4">
                                            <button type="button" class="btn btn-outline-glass px-4" data-bs-dismiss="modal">Нет, оставить</button>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@car.Id">
                                                <button type="submit" class="btn btn-glass px-4">Да, удалить</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted">Автомобилей пока нет в базе данных.</p>
                <a asp-page="Create" class="btn btn-glass mt-2">
                    <i class="fas fa-plus me-2"></i>Добавить первый автомобиль
                </a>
            </div>
        }
    </div>
</div>