@page
@model ServiceHub.Pages.Admin.Cars.IndexModel
@{
    ViewData["Title"] = "Управление автомобилями";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Автомобили</h2>

    <a asp-page="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Добавить автомобиль
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        @if (Model.Cars.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Марка</th>
                            <th>Модель</th>
                            <th>Госномер</th>
                            <th>Тип</th>
                            <th>Вместимость</th>
                            <th>Доступен</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var car in Model.Cars)
                        {
                            <tr>
                                <td>@car.Id</td>
                                <td>@car.Brand</td>
                                <td>@car.Model</td>
                                <td>@car.LicensePlate</td>
                                <td>@car.VehicleType</td>
                                <td>@(car.PassengerCapacity?.ToString() ?? "—")</td>
                                <td>
                                    <form method="post" asp-page-handler="ToggleAvailability" style="display:inline;">
                                        <input type="hidden" name="id" value="@car.Id" />
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch"
                                                   id="available-@car.Id"
                                                   name="isAvailable"
                                                   value="true"
                                                   @(car.IsAvailable ? "checked" : "")
                                                   onchange="this.form.submit()">
                                            <label class="form-check-label" for="available-@car.Id">
                                                @(car.IsAvailable ? "Да" : "Нет")
                                            </label>
                                        </div>
                                    </form>
                                </td>
                                <td>
                                    @if (car.VehicleType == "Минивэн" || car.VehicleType == "Автобус")
                                    {
                                        <a asp-page="/Admin/TransferRoutes/Index" asp-route-carId="@car.Id" class="btn btn-sm btn-outline-info" title="Маршруты">
                                            <i class="fas fa-route"></i>
                                        </a>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal-@car.Id">
                                        <i class="fas fa-trash"></i>
                                    </button>

                                    <!-- Модальное окно подтверждения удаления -->
                                    <div class="modal fade" id="deleteModal-@car.Id" tabindex="-1"
                                         aria-labelledby="deleteModalLabel-@car.Id" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="deleteModalLabel-@car.Id">Подтверждение удаления</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Вы уверены, что хотите удалить автомобиль <strong>@car.Brand @car.Model</strong>?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                                                    <form method="post" asp-page-handler="Delete" asp-route-id="@car.Id">
                                                        <button type="submit" class="btn btn-danger">Удалить</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">Автомобилей пока нет.</p>
        }
    </div>
</div>