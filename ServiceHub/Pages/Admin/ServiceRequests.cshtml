@page
@model ServiceHub.Pages.Admin.ServiceRequestsModel
@{
    ViewData["Title"] = "Управление заявками";
}

<div class="container mt-5">
    <h2 class="mb-4">Управление заявками</h2>

    <div class="card shadow">
        <div class="card-header">
            <div class="row">
                <div class="col-md-4">
                    <select class="form-select form-select-sm">
                        <option>Все типы заявок</option>
                        <option>Транспорт</option>
                        <option>Поддержка</option>
                        <option>Питание</option>
                        <option>Помещения</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <select class="form-select form-select-sm">
                        <option>Все статусы</option>
                        <option>Ожидание</option>
                        <option>В работе</option>
                        <option>Завершено</option>
                        <option>Отменено</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <input type="text" class="form-control form-control-sm" placeholder="Поиск...">
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Тип</th>
                            <th>Заголовок</th>
                            <th>Пользователь</th>
                            <th>Дата создания</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model.ServiceRequests)
                        {
                            <tr>
                                <td>#@request.Id</td>
                                <td>
                                    @if (request.ServiceType == "Транспорт")
                                    {
                                        <span class="badge bg-info">🚗 @request.ServiceType</span>
                                    }
                                    else if (request.ServiceType == "Поддержка")
                                    {
                                        <span class="badge bg-warning">🛠️ @request.ServiceType</span>
                                    }
                                    else if (request.ServiceType == "Питание")
                                    {
                                        <span class="badge bg-success">🍽️ @request.ServiceType</span>
                                    }
                                    else if (request.ServiceType == "Помещения")
                                    {
                                        <span class="badge bg-primary">🏢 @request.ServiceType</span>
                                    }
                                </td>
                                <td>@request.Title</td>
                                <td>@request.User?.FirstName @request.User?.LastName</td>
                                <td>@request.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (request.Status == "Ожидание")
                                    {
                                        <span class="badge bg-secondary">@request.Status</span>
                                    }
                                    else if (request.Status == "В работе")
                                    {
                                        <span class="badge bg-warning">@request.Status</span>
                                    }
                                    else if (request.Status == "Завершено")
                                    {
                                        <span class="badge bg-success">@request.Status</span>
                                    }
                                    else if (request.Status == "Отменено")
                                    {
                                        <span class="badge bg-danger">@request.Status</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="/Admin/ServiceRequest?id=@request.Id" class="btn btn-outline-primary">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@request.Id" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger"
                                                    onclick="return confirm('Вы уверены, что хотите удалить эту заявку?');">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>