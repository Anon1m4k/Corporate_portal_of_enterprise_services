@page
@model ServiceHub.Pages.Admin.ServiceRequestsModel
@{
    ViewData["Title"] = "Управление заявками";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title">Управление заявками</h2>
</div>

<!-- Форма для отчёта -->
<div class="card shadow mb-4">
    <div class="card-header">
        <h5 class="mb-0">Сформировать отчёт</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Export" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Начальная дата</label>
                <input type="date" name="startDate" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Конечная дата</label>
                <input type="date" name="endDate" class="form-control" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Статус</label>
                <select name="status" class="form-select">
                    <option value="">Все статусы</option>
                    @foreach (var s in Model.AllStatuses)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100 rounded-pill shadow-lg">
                    <i class="fas fa-file-excel me-2"></i>Сформировать
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow">
    <div class="card-header">
        <div class="row">
            <div class="col-md-3">
                <select class="form-select" id="statusFilter" onchange="filterChanged()">
                    <option value="">Все статусы</option>
                    @foreach (var status in Model.AllStatuses)
                    {
                        <option value="@status" selected="@(Model.CurrentStatus == status)">@status</option>
                    }
                </select>
            </div>
            <div class="col-md-9"></div>
        </div>
    </div>
    <div class="card-body">
        @if (Model.ServiceRequests.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Тип</th>
                            <th>Пользователь</th>
                            <th>Заголовок</th>
                            <th>Описание / Детали</th>
                            <th>Дата создания</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ServiceRequests)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td>
                                    @if (item.ServiceType == "Транспорт")
                                    {
                                        <span class="badge bg-info">🚗 @item.ServiceType</span>
                                    }
                                    else if (item.ServiceType == "Поддержка")
                                    {
                                        <span class="badge bg-warning">🛠️ @item.ServiceType</span>
                                    }
                                    else if (item.ServiceType == "Питание")
                                    {
                                        <span class="badge bg-success">🍽️ @item.ServiceType</span>
                                    }
                                    else if (item.ServiceType == "Помещения")
                                    {
                                        <span class="badge bg-primary">🏢 @item.ServiceType</span>
                                    }
                                </td>
                                <td>@(item.User?.FirstName ?? "") @(item.User?.LastName ?? "")</td>
                                <td>@item.Title</td>
                                <td>@item.Description</td>
                                <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (item.Status == "На согласовании")
                                    {
                                        <span class="badge bg-warning">@item.Status</span>
                                    }
                                    else if (item.Status == "Подтверждена")
                                    {
                                        <span class="badge bg-success">@item.Status</span>
                                    }
                                    else if (item.Status == "Выполнена")
                                    {
                                        <span class="badge bg-info">@item.Status</span>
                                    }
                                    else if (item.Status == "Отклонена")
                                    {
                                        <span class="badge bg-danger">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        @if (item.Status != "Выполнена")
                                        {
                                            <form method="post" asp-page-handler="ChangeStatus" class="d-flex gap-1">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="type" value="@item.ServiceType" />
                                                <input type="hidden" name="currentStatus" value="@Model.CurrentStatus" />
                                                <input type="hidden" name="currentType" value="@Model.CurrentType" />
                                                <select name="newStatus" class="form-select form-select-sm" style="width: 130px;">
                                                    @foreach (var s in Model.AllStatuses)
                                                    {
                                                        <option value="@s" selected="@(s == item.Status)">@s</option>
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Изменить статус">✓</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">Заявок нет.</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        function filterChanged() {
            const status = document.getElementById('statusFilter').value;
            const url = new URL(window.location.href);
            if (status) {
                url.searchParams.set('status', status);
            } else {
                url.searchParams.delete('status');
            }
            window.location.href = url.toString();
        }
    </script>
}