@page
@model ServiceHub.Pages.Admin.ServiceRequestsModel
@{
    ViewData["Title"] = "Управление заявками";
}

<div>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-primary">Управление заявками</h2>
</div>

<!-- Форма для отчёта -->
<div class="card bg-white shadow-sm rounded-3 mb-4">
    <div class="card-header">
        <h5 class="mb-0">Сформировать отчёт</h5>
    </div>
    <div class="card-body p-3">
        <form method="post" asp-page-handler="Export" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">Начальная дата</label>
                <input type="date" name="startDate" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Конечная дата</label>
                <input type="date" name="endDate" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Статус</label>
                <select name="status" class="form-select">
                    <option value="">Все статусы</option>
                    @foreach (var s in Model.AllStatuses)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex justify-content-center align-items-end">
                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm text-nowrap">
                    <i class="fas fa-file-excel me-2"></i>Сформировать
                </button>
            </div>
        </form>
    </div>
</div>
<div class="card shadow-lg rounded-3">
    <div class="card-header p-2">
        <div class="row">
            <div class="col-md-3">
                <select class="form-select" id="statusFilter" onchange="filterChanged()">
                    <option value="">Все статусы</option>
                    @foreach (var status in Model.AllStatuses)
                    {
                        <option value="@status" selected="@(Model.CurrentStatus == status)">@status</option>
                    }
                </select>
            </div>
            <div class="col-md-9"></div>
        </div>
    </div>
    <div class="card-body p-2">
        @if (Model.ServiceRequests.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center">
                    <thead>
                        <tr>
                            <th class="ps-4 align-middle">ID</th>
                            <th class="align-middle">Тип</th>
                            <th class="align-middle">Пользователь</th>
                            <th class="align-middle">Заголовок</th>
                            <th class="align-middle">Описание / Детали</th>
                            <th class="align-middle">Дата создания</th>
                            <th class="align-middle">Статус</th>
                            <th class ="align-middle">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ServiceRequests)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>
                                    @if (item.ServiceType == "Транспорт")
                                    {
                                            <span class="badge bg-info text-black">🚗 @item.ServiceType</span>
                                    }
                                    else if (item.ServiceType == "Поддержка")
                                    {
                                        <span class="badge bg-warning">🛠️ @item.ServiceType</span>
                                    }
                                    else if (item.ServiceType == "Питание")
                                    {
                                        <span class="badge bg-success">🍽️ @item.ServiceType</span>
                                    }
                                    else if (item.ServiceType == "Помещения")
                                    {
                                        <span class="badge bg-primary">🏢 @item.ServiceType</span>
                                    }
                                </td>
                                <td>@(item.User?.FirstName ?? "") @(item.User?.LastName ?? "")</td>
                                <td>@item.Title</td>
                                <td>@item.Description</td>
                                <td>
                                    <div>@item.CreatedAt.ToString("dd.MM.yyyy")</div>
                                    <div class="small text-primary">@item.CreatedAt.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    @if (item.Status == "На согласовании")
                                    {
                                        <span class="badge bg-warning text-dark">@item.Status</span>
                                    }
                                    else if (item.Status == "Подтверждена")
                                    {
                                        <span class="badge bg-success">@item.Status</span>
                                    }
                                    else if (item.Status == "Выполнена")
                                    {
                                        <span class="badge bg-info text-dark">@item.Status</span>
                                    }
                                    else if (item.Status == "Отклонена")
                                    {
                                        <span class="badge bg-danger">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        @if (item.Status != "Выполнена")
                                        {
                                            <form method="post" asp-page-handler="ChangeStatus">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="type" value="@item.ServiceType" />
                                                <input type="hidden" name="currentStatus" value="@Model.CurrentStatus" />
                                                <input type="hidden" name="currentType" value="@Model.CurrentType" />

                                                <select name="newStatus" class="form-select form-select-sm mb-2" style="width: auto; min-width: 150px;">
                                                    @foreach (var s in Model.AllStatuses)
                                                    {
                                                        <option value="@s" selected="@(s == item.Status)">@s</option>
                                                    }
                                                </select>

                                                <div class="d-flex justify-content-center">
                                                    <button type="submit" class="btn btn-sm btn-primary" style="width: 42px; height: 42px; padding: 0; display: inline-flex; align-items: center; justify-content: center;" title="Изменить статус">✓</button>
                                                </div>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">Заявок нет.</p>
        }
    </div>
</div>
</div>

@section Scripts {
    <script>
        function filterChanged() {
            const status = document.getElementById('statusFilter').value;
            const url = new URL(window.location.href);
            if (status) {
                url.searchParams.set('status', status);
            } else {
                url.searchParams.delete('status');
            }
            window.location.href = url.toString();
        }
    </script>
}