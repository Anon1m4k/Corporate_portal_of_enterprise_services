@page
@model IndexModel
@{
    ViewData["Title"] = "ServiceHub - Портал внутренних услуг";
}

<div class="container py-5">
    <div class="text-center mb-5 animate-in">
        <h1 class="display-5 fw-bold glass-title mb-3">Добро пожаловать в ServiceHub</h1>
        <p class="lead" style="color: var(--text-muted);">Единый портал для заказа внутренних услуг предприятия</p>
    </div>

    <div class="row g-4 justify-content-center">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <!-- Поездки -->
            <div class="col-lg-3 col-md-6 animate-in" style="animation-delay: 0.1s">
                <a asp-page="/Transport/Index" class="text-decoration-none">
                    <div class="glass-card p-4 h-100 text-center service-card">
                        <div class="service-icon mb-3">
                            <i class="fas fa-car fa-2x"></i>
                        </div>
                        <h5 class="fw-bold mb-2" style="color: var(--text-primary);">Поездки</h5>
                        <p class="small" style="color: var(--text-muted);">Заказ служебного транспорта, отслеживание статуса</p>
                    </div>
                </a>
            </div>

            <!-- Переговорные -->
            <div class="col-lg-3 col-md-6 animate-in" style="animation-delay: 0.2s">
                <a asp-page="/Rooms/Index" class="text-decoration-none">
                    <div class="glass-card p-4 h-100 text-center service-card">
                        <div class="service-icon mb-3">
                            <i class="fas fa-door-open fa-2x"></i>
                        </div>
                        <h5 class="fw-bold mb-2" style="color: var(--text-primary);">Переговорные</h5>
                        <p class="small" style="color: var(--text-muted);">Бронирование помещений для встреч и совещаний</p>
                    </div>
                </a>
            </div>

            <!-- Личный кабинет -->
            <div class="col-lg-3 col-md-6 animate-in" style="animation-delay: 0.4s">
                <a asp-page="/Account/Dashboard" class="text-decoration-none">
                    <div class="glass-card p-4 h-100 text-center service-card">
                        <div class="service-icon mb-3">
                            <i class="fas fa-tachometer-alt fa-2x"></i>
                        </div>
                        <h5 class="fw-bold mb-2" style="color: var(--text-primary);">Личный кабинет</h5>
                        <p class="small" style="color: var(--text-muted);">Статистика, история заявок и профиль</p>
                    </div>
                </a>
            </div>            
        }
        else
        {
            <!-- Блок для неавторизованных посетителей -->
            <div class="col-md-8 col-lg-6 animate-in">
                <div class="glass-card p-5 text-center">
                    <div class="auth-icon mb-4">
                        <i class="fas fa-lock-open fa-2x"></i>
                    </div>
                    <h3 class="fw-bold mb-3" style="color: var(--text-primary);">Доступ к сервисам</h3>
                    <p class="mb-4" style="color: var(--text-muted);">Войдите или создайте аккаунт, чтобы начать работу</p>
                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <a asp-page="/Account/Login" class="btn btn-glass px-5 text-nowrap">
                            <i class="fas fa-sign-in-alt me-2"></i>Войти
                        </a>
                        <a asp-page="/Account/Register" class="btn btn-outline-glass px-5 text-nowrap">
                            <i class="fas fa-user-plus me-2"></i>Регистрация
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>