@page
@model IndexModel
@{
    ViewData["Title"] = "ServiceHub - Портал внутренних услуг";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center justify-content-center bg-primary rounded-circle p-3 mx-auto mb-4" style="width: 80px; height: 80px;">
            <i class="fas fa-cubes fa-2x text-white"></i>
        </div>
        <h1 class="display-4 fw-bold text-primary mb-3">Добро пожаловать в ServiceHub</h1>
        <p class="lead text-muted">Единый портал для заказа внутренних услуг предприятия</p>
    </div>

    <div class="row g-4 justify-content-center">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="col-md-4">
                <div class="card h-100 text-center shadow-lg rounded-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary rounded-circle p-3 mx-auto mt-4" style="width: 80px; height: 80px;">
                        <i class="fas fa-truck fa-2x text-white"></i>
                    </div>
                    <div class="card-body p-4">
                        <h5 class="fw-bold mt-3">Транспортные заявки</h5>
                        <p class="text-muted">Оформление служебных поездок, отслеживание статуса, история</p>
                        <a asp-page="/Transport/Index" class="btn btn-primary btn-lg mt-3 rounded-pill px-4">Перейти</a>
                    </div>
                </div>
            </div>
        }

        @if (User.IsInRole("Admin"))
        {
            <div class="col-md-4">
                <div class="card h-100 text-center shadow-lg rounded-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary rounded-circle p-3 mx-auto mt-4" style="width: 80px; height: 80px;">
                        <i class="fas fa-warehouse fa-2x text-white"></i>
                    </div>
                    <div class="card-body p-4">
                        <h5 class="fw-bold mt-3">Управление автопарком</h5>
                        <p class="text-muted">Добавление, редактирование автомобилей, контроль состояния</p>
                        <a asp-page="/Admin/Cars/Index" class="btn btn-primary btn-lg mt-3 rounded-pill px-4">Управлять</a>
                    </div>
                </div>
            </div>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="col-md-4">
                <div class="card h-100 text-center shadow-lg rounded-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary rounded-circle p-3 mx-auto mt-4" style="width: 80px; height: 80px;">
                        <i class="fas fa-map-signs fa-2x text-white"></i>
                    </div>
                    <div class="card-body p-4">
                        <h5 class="fw-bold mt-3">Планирование маршрутов</h5>
                        <p class="text-muted">Просмотр регулярных трансферов, остановок и расписания</p>
                        <a asp-page="/Transport/Schedule" class="btn btn-primary btn-lg mt-3 rounded-pill px-4">Смотреть</a>
                    </div>
                </div>
            </div>
        }

        @if (!User.Identity?.IsAuthenticated == true)
        {
            <div class="col-md-8 mx-auto">
                <div class="card text-center border-0 shadow-lg rounded-3 bg-white">
                    <div class="card-body p-5">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary rounded-circle p-3 mx-auto mb-4" style="width: 80px; height: 80px;">
                            <i class="fas fa-sign-in-alt fa-2x text-white"></i>
                        </div>
                        <h3 class="fw-bold mb-3">Добро пожаловать!</h3>
                        <p class="text-muted mb-4">Для доступа к сервисам необходимо войти в систему или зарегистрироваться</p>
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-page="/Account/Login" class="btn btn-primary btn-lg rounded-pill px-5">
                                <i class="fas fa-sign-in-alt me-2"></i>Войти     
                            </a>
                            <a asp-page="/Account/Register" class="btn btn-outline-primary btn-lg rounded-pill px-5">
                                <i class="fas fa-user-plus me-2"></i>Регистрация
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>