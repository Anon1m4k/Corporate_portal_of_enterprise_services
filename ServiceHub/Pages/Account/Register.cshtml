@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="container mt-5 fade-in">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="fas fa-user-plus fa-4x text-primary"></i>
                        <h2 class="mt-3 fw-bold">Создать аккаунт</h2>
                        <p class="text-muted">Заполните форму для регистрации</p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.FirstName" class="form-label fw-medium">Имя</label>
                                <input asp-for="Input.FirstName" class="form-control rounded-3" placeholder="Иван" />
                                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.LastName" class="form-label fw-medium">Фамилия</label>
                                <input asp-for="Input.LastName" class="form-control rounded-3" placeholder="Петров" />
                                <span asp-validation-for="Input.LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-medium">Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fas fa-envelope text-primary"></i></span>
                                <input asp-for="Input.Email" class="form-control rounded-3" placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Department" class="form-label fw-medium">Отдел</label>
                            <input asp-for="Input.Department" class="form-control rounded-3" placeholder="Отдел разработки" />
                            <span asp-validation-for="Input.Department" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Password" class="form-label fw-medium">Пароль</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="fas fa-lock text-primary"></i></span>
                                    <input asp-for="Input.Password" type="password" class="form-control rounded-3" />
                                </div>
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.ConfirmPassword" class="form-label fw-medium">Подтверждение</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="fas fa-lock text-primary"></i></span>
                                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control rounded-3" />
                                </div>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3">
                                <i class="fas fa-user-check me-2"></i>Зарегистрироваться
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-page="/Account/Login" class="text-decoration-none">
                            <i class="fas fa-sign-in-alt me-1"></i>Уже есть аккаунт? Войти
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>