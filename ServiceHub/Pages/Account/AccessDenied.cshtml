@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Доступ запрещён";
}

<div class="container mt-5 text-center glass-card p-5 fade-in">
    <div class="display-1 text-muted mb-4">
        <i class="fas fa-lock text-danger"></i>
    </div>
    <h1 class="display-4">Доступ запрещён</h1>
    <p class="lead text-muted mt-3">У вас нет прав для доступа к этой странице.</p>
    <a asp-page="/Index" class="btn btn-glass btn-lg mt-4 rounded-pill px-5">
        <i class="fas fa-home me-2"></i>На главную
    </a>
</div>