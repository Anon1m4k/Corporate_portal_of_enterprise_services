@page
@model HistoryModel
@{
    ViewData["Title"] = "История заявок";
    Layout = "_ProfileLayout";
}

<div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 glass-title">История заявок</h1>
    </div>

    <!-- Панель управления историей -->
    <div class="glass-container p-3 mb-4">
        <div class="row mb-3">
            <div class="col-md-4">
                <select class="form-select" id="filterStatus" onchange="filterHistory()">
                    <option value="">Все статусы</option>
                    <option value="На согласовании">На согласовании</option>
                    <option value="Подтверждена">Подтверждена</option>
                    <option value="Выполнена">Выполнена</option>
                    <option value="Отклонена">Отклонена</option>
                </select>
            </div>
        </div>

        <div class="row g-3" id="historyContainer">
            @foreach (var request in Model.ServiceRequests)
            {
                <div class="col-12 col-md-6 history-item" data-status="@request.Status">
                    <div class="glass-card p-3 h-100">
                        <!-- Гибкий ряд с переносом бейджей -->
                        <div class="d-flex flex-wrap align-items-start justify-content-between mb-2 gap-2">
                            <span class="badge badge-glass
                                        @(request.ServiceType == "Транспорт" ? "bg-info text-white" :
                                                                        request.ServiceType == "Поддержка" ? "bg-warning text-dark" :
                                                                        request.ServiceType == "Питание" ? "bg-success" :
                                                                        request.ServiceType == "Помещения" ? "bg-primary" : "bg-secondary")">
                            @switch (request.ServiceType)
                                {
                                    case "Транспорт":
                                        @("🚗 Транспорт")
                                        break;
                                    case "Поддержка":
                                        @("🛠️ Поддержка")
                                        break;
                                    case "Питание":
                                        @("🍽️ Питание")
                                        break;
                                    case "Помещения":
                                        @("🏢 Помещения")
                                        break;
                                    default:
                                        @request.ServiceType
                                        break;
                                }
                        </span>
                        <span class="badge badge-glass status-badge
                                    @(request.Status == "На согласовании" ? "bg-warning text-dark" :
                                                                    request.Status == "Подтверждена" ? "bg-success" :
                                                                    request.Status == "Выполнена" ? "bg-info text-dark" :
                                                                    request.Status == "Отклонена" ? "bg-danger" : "bg-secondary")">
                            @request.Status
                        </span>
                    </div>
                    <h6 class="fw-bold">@request.Title</h6>
                    <div class="small" style="color: var(--text-muted);">@request.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                    <button class="btn btn-sm btn-glass mt-2 view-details"
                            data-id="@request.Id"
                            data-title="@request.Title"
                            data-type="@request.ServiceType"
                            data-status="@request.Status"
                            data-date="@request.CreatedAt.ToString("dd.MM.yyyy HH:mm")"
                            data-description="@request.Description">
                        <i class="fas fa-info-circle"></i>
                    </button>
                </div>
            </div>
                        }
        </div>
    </div>
</div>

<!-- Модальное окно деталей -->
<div class="modal fade modal-glass" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold"><i class="fas fa-info-circle me-2"></i>Информация о заявке</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center mb-4">
                    <div class="service-icon me-3" style="width: 60px; height: 60px;">
                        <i class="fas fa-file-invoice"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold" id="modalTitle"></h4>
                        <span id="modalId"></span>
                    </div>
                </div>
                <hr class="my-4">
                <div>
                    <p class="text-start"><strong>Тип услуги: </strong><span id="modalType"></span></p>
                    <p class="text-start"><strong>Статус: </strong><span id="modalStatus"></span></p>
                    <p class="text-start"><strong>Дата создания: </strong><span id="modalDate"></span></p>
                    <p class="text-start"><strong>Описание: </strong><span id="modalDescription"></span></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterHistory() {
            const statusValue = document.getElementById('filterStatus').value;
            const items = document.querySelectorAll('.history-item');
            items.forEach(item => {
                item.style.display = (!statusValue || item.dataset.status === statusValue) ? '' : 'none';
            });
        }

        document.querySelectorAll('.view-details').forEach(button => {
            button.addEventListener('click', function() {
                document.getElementById('modalId').textContent = 'ID Заявки: #' + this.dataset.id;
                document.getElementById('modalType').textContent = this.dataset.type;
                document.getElementById('modalTitle').textContent = this.dataset.title;
                document.getElementById('modalDate').textContent = this.dataset.date;
                document.getElementById('modalStatus').textContent = this.dataset.status;
                document.getElementById('modalDescription').textContent = this.dataset.description || 'Комментарий отсутствует';
                new bootstrap.Modal(document.getElementById('detailsModal')).show();
            });
        });
    </script>
}