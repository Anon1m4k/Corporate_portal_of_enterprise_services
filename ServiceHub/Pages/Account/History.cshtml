@page
@model HistoryModel
@{
    ViewData["Title"] = "История заявок";
    Layout = "_ProfileLayout";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3">
    <h1 class="h2">История заявок</h1>
</div>

<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-filter"></i></span>
                    <select class="form-select" id="filterStatus" onchange="filterTable()">
                        <option value="">Все статусы</option>
                        <option value="На согласовании">На согласовании</option>
                        <option value="Подтверждена">Подтверждена</option>
                        <option value="Выполнена">Выполнена</option>
                        <option value="Отклонена">Отклонена</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Тип</th>
                        <th>Заголовок</th>
                        <th>Дата создания</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.ServiceRequests)
                    {
                        <tr>
                            <td>#@request.Id</td>
                            <td>
                                @if (request.ServiceType == "Транспорт")
                                {
                                    <span class="badge bg-info"><i class="fas fa-car me-1"></i>Транспорт</span>
                                }
                                else if (request.ServiceType == "Поддержка")
                                {
                                    <span class="badge bg-warning"><i class="fas fa-tools me-1"></i>Поддержка</span>
                                }
                                else if (request.ServiceType == "Питание")
                                {
                                    <span class="badge bg-success"><i class="fas fa-utensils me-1"></i>Питание</span>
                                }
                                else if (request.ServiceType == "Помещения")
                                {
                                    <span class="badge bg-primary"><i class="fas fa-door-open me-1"></i>Помещения</span>
                                }
                            </td>
                            <td>@request.Title</td>
                            <td>@request.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @if (request.Status == "На согласовании")
                                {
                                    <span class="badge bg-warning">@request.Status</span>
                                }
                                else if (request.Status == "Подтверждена")
                                {
                                    <span class="badge bg-success">@request.Status</span>
                                }
                                else if (request.Status == "Выполнена")
                                {
                                    <span class="badge bg-info">@request.Status</span>
                                }
                                else if (request.Status == "Отклонена")
                                {
                                    <span class="badge bg-danger">@request.Status</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary view-details"
                                        data-id="@request.Id"
                                        data-title="@request.Title"
                                        data-type="@request.ServiceType"
                                        data-status="@request.Status"
                                        data-date="@request.CreatedAt.ToString("dd.MM.yyyy HH:mm")"
                                        data-description="@request.Description"
                                        title="Подробнее">
                                    <i class="fas fa-info-circle"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Модальное окно для деталей заявки -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-file-alt me-2"></i>Детали заявки</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>ID:</strong> <span id="modalId"></span></p>
                <p><strong>Тип:</strong> <span id="modalType"></span></p>
                <p><strong>Заголовок:</strong> <span id="modalTitle"></span></p>
                <p><strong>Дата создания:</strong> <span id="modalDate"></span></p>
                <p><strong>Статус:</strong> <span id="modalStatus"></span></p>
                <p><strong>Описание:</strong> <span id="modalDescription"></span></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-2"></i>Закрыть</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable() {
            const statusFilter = document.getElementById('filterStatus').value;
            const rows = document.querySelectorAll('tbody tr');

            rows.forEach(row => {
                const statusCell = row.cells[4]; // колонка статуса (индекс 4)
                const status = statusCell.textContent.trim();

                const showStatus = !statusFilter || status.includes(statusFilter);
                row.style.display = showStatus ? '' : 'none';
            });
        }

        document.querySelectorAll('.view-details').forEach(button => {
            button.addEventListener('click', function() {
                document.getElementById('modalId').textContent = this.dataset.id;
                document.getElementById('modalType').textContent = this.dataset.type;
                document.getElementById('modalTitle').textContent = this.dataset.title;
                document.getElementById('modalDate').textContent = this.dataset.date;
                document.getElementById('modalStatus').textContent = this.dataset.status;
                document.getElementById('modalDescription').textContent = this.dataset.description || 'Нет описания';

                const modal = new bootstrap.Modal(document.getElementById('detailsModal'));
                modal.show();
            });
        });
    </script>
}