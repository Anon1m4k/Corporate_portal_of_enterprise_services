@page
@model HistoryModel
@{
    ViewData["Title"] = "История заявок";
    Layout = "_ProfileLayout";
}

<div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 fw-bold text-primary">История заявок</h1>
    </div>

    <!-- Панель управления историей -->
    <div class="card shadow-lg rounded-3">
        <div class="card-header">         
                <div class="col-md-4">
                    <div class="input-group">
                    <select class="form-select" id="filterStatus" onchange="filterHistory()">
                            <option value="">Все статусы</option>
                            <option value="На согласовании">На согласовании</option>
                            <option value="Подтверждена">Подтверждена</option>
                            <option value="Выполнена">Выполнена</option>
                            <option value="Отклонена">Отклонена</option>
                        </select>
                    </div>
                </div>          
        </div>
        <div class="card-body p-2">
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 align-middle">ID</th>
                            <th class="align-middle">Тип</th>
                            <th class="align-middle">Заголовок</th>
                            <th class="align-middle">Дата создания</th>
                            <th class="align-middle">Статус</th>
                            <th class="align-middle">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model.ServiceRequests)
                        {
                            <tr class="history-row">
                                <td class="ps-4">@request.Id</td>
                                <td>
                                    @switch (request.ServiceType)
                                    {
                                        case "Транспорт":
                                            <span class="badge bg-info text-black"> 🚗 Транспорт</span>
                                            break;
                                        case "Поддержка":
                                            <span class="badge bg-warning text-dark"> Поддержка</span>
                                            break;
                                        case "Питание":
                                            <span class="badge bg-success"> Питание</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@request.ServiceType</span>
                                            break;
                                    }
                                </td>
                                <td class="search-target">@request.Title</td>
                                <td>
                                    <div>@request.CreatedAt.ToString("dd.MM.yyyy")</div>
                                    <div class="small text-primary">@request.CreatedAt.ToString("HH:mm")</div>
                                </td>
                                <td class="text-center status-cell">
                                    @switch (request.Status)
                                    {
                                        case "На согласовании":
                                            <span class="badge bg-warning text-black">На согласовании</span>
                                            break;
                                        case "Подтверждена":
                                            <span class="badge bg-success">Подтверждена</span>
                                            break;
                                        case "Выполнена":
                                            <span class="badge bg-info text-black">Выполнена</span>
                                            break;
                                        case "Отклонена":
                                            <span class="badge bg-danger">Отклонена</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@request.Status</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-primary view-details"
                                            style="width: 42px; height: 42px; padding: 0; display: inline-flex; align-items: center; justify-content: center;"
                                            title="Подробнее"
                                            data-id="@request.Id"
                                            data-title="@request.Title"
                                            data-type="@request.ServiceType"
                                            data-status="@request.Status"
                                            data-date="@request.CreatedAt.ToString("dd.MM.yyyy HH:mm")"
                                            data-description="@request.Description">
                                        <i class="fas fa-info-circle"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно деталей -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg rounded-3">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold"><i class="fas fa-info-circle me-2"></i>Информация о заявке</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-light text-primary rounded-circle d-inline-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                        <i class="fas fa-file-invoice fa-lg"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold" id="modalTitle"></h4>
                        <span id="modalId"></span>
                    </div>
                </div>
                <hr class="my-4">
                <div>
                    <p class="text-start"><strong>Тип услуги: </strong><span id="modalType"></span></p> 
                    <p class="text-start"><strong>Статус: </strong><span id="modalStatus"></span></p>
                    <p class="text-start"><strong>Дата создания: </strong><span id="modalDate"></span></p>
                    <p class="text-start"><strong>Описание: </strong><span id="modalDescription"></span></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterHistory() {
            const statusValue = document.getElementById('filterStatus').value;
            const rows = document.querySelectorAll('.history-row');

            rows.forEach(row => {
                const statusCell = row.querySelector('.status-cell');
                if (!statusCell) return;
                const statusText = statusCell.textContent.trim();

                const matchesStatus = !statusValue || statusText.includes(statusValue);
                row.style.display = matchesStatus ? '' : 'none';
            });
        }
        document.querySelectorAll('.view-details').forEach(button => {
            button.addEventListener('click', function() {
                document.getElementById('modalId').textContent = 'ID Заявки: #' + this.dataset.id;
                document.getElementById('modalType').textContent = this.dataset.type;
                document.getElementById('modalTitle').textContent = this.dataset.title;
                document.getElementById('modalDate').textContent = this.dataset.date;
                document.getElementById('modalStatus').textContent = this.dataset.status;
                document.getElementById('modalDescription').textContent = this.dataset.description || 'Комментарий отсутствует';

                new bootstrap.Modal(document.getElementById('detailsModal')).show();
            });
        });
    </script>
}