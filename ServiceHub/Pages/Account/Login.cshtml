@page
@model LoginModel
@{
    ViewData["Title"] = "Вход в систему";
}

<div class="container mt-5 fade-in">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-xl rounded-4 float-animation">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <div class="icon-box mx-auto mb-4">
                            <i class="fas fa-user-circle"></i>
                        </div>
                        <h2 class="fw-bold section-title mb-3">Добро пожаловать</h2>
                        <p class="text-muted lead">Войдите в свой аккаунт</p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.Email" class="form-control rounded-16" placeholder="name@example.com" />
                            <label asp-for="Input.Email">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.Password" type="password" class="form-control rounded-16" placeholder="Пароль" />
                            <label asp-for="Input.Password">Пароль</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill">
                            <i class="fas fa-sign-in-alt me-2"></i>Войти
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-page="/Account/Register" class="text-decoration-none">
                            <i class="fas fa-user-plus me-1"></i>Нет аккаунта? Зарегистрироваться
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>