@page
@model ServiceHub.Pages.LoginModel
@{
    ViewData["Title"] = "Вход в систему";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg rounded-3">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary rounded-circle p-3 mx-auto mb-4" style="width: 80px; height: 80px;">
                            <i class="fas fa-user-circle fa-2x text-white"></i>
                        </div>
                        <h2 class="fw-bold text-primary mb-3">Добро пожаловать</h2>
                        <p class="text-muted lead">Войдите в свой аккаунт</p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Input.Email" class="form-label fw-medium">Email</label>
                            <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Password" class="form-label fw-medium">Пароль</label>
                            <input asp-for="Input.Password" type="password" class="form-control" placeholder="Пароль" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill">
                            <i class="fas fa-sign-in-alt me-2"></i>Войти
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <a asp-page="/Account/Register" class="text-decoration-none">
                            <i class="fas fa-user-plus me-1"></i>Нет аккаунта? Зарегистрироваться
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>