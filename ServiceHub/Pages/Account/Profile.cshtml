@page
@model ProfileModel
@{
    ViewData["Title"] = "Профиль";
    Layout = "_ProfileLayout";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-lg rounded-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 fw-bold text-primary">Профиль пользователя @Model.CurrentUser.Email</h1>
        </div>
        
        @if (Model.IsAdmin)
        {
            <form method="post" class="mt-3">
                <input type="hidden" asp-for="CurrentUser.Id" />
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CurrentUser.FirstName" class="form-label fw-bold">Имя</label>
                        <input asp-for="CurrentUser.FirstName" class="form-control rounded-16" />
                        <span asp-validation-for="CurrentUser.FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CurrentUser.LastName" class="form-label fw-bold">Фамилия</label>
                        <input asp-for="CurrentUser.LastName" class="form-control rounded-16" />
                        <span asp-validation-for="CurrentUser.LastName" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                    <label asp-for="CurrentUser.Email" class="form-label fw-bold">Email</label>
                    <input asp-for="CurrentUser.Email" class="form-control rounded-16" />
                    <span asp-validation-for="CurrentUser.Email" class="text-danger"></span>
                </div>
                    <div class="col-md-6 mb-3">
                    <label asp-for="CurrentUser.Department" class="form-label fw-bold">Отдел</label>
                    <input asp-for="CurrentUser.Department" class="form-control rounded-16" />
                    <span asp-validation-for="CurrentUser.Department" class="text-danger"></span>
                </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CurrentUser.Role" class="form-label fw-bold">Роль</label>
                    <select asp-for="CurrentUser.Role" class="form-select rounded-16">
                        <option value="User">Пользователь</option>
                        <option value="Admin">Администратор</option>
                    </select>
                    <span asp-validation-for="CurrentUser.Role" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="fas fa-save me-2"></i>Сохранить</button>
            </form>
        }
        else
        {
            <dl class="row mt-3">
                <dt class="col-sm-3 fw-medium"><i class="fas fa-user me-2"></i>Имя</dt>
                <dd class="col-sm-9">@Model.CurrentUser.FirstName</dd>

                <dt class="col-sm-3 fw-medium"><i class="fas fa-user me-2"></i>Фамилия</dt>
                <dd class="col-sm-9">@Model.CurrentUser.LastName</dd>

                <dt class="col-sm-3 fw-medium"><i class="fas fa-envelope me-2"></i>Email</dt>
                <dd class="col-sm-9">@Model.CurrentUser.Email</dd>

                <dt class="col-sm-3 fw-medium"><i class="fas fa-building me-2"></i>Отдел</dt>
                <dd class="col-sm-9">@Model.CurrentUser.Department</dd>

                <dt class="col-sm-3 fw-medium"><i class="fas fa-shield-alt me-2"></i>Роль</dt>
                <dd class="col-sm-9">@Model.CurrentUser.Role</dd>
            </dl>
        }
    </div>
</div>

@section Scripts {
    @if (Model.IsAdmin)
    {
        <partial name="_ValidationScriptsPartial" />
    }
}