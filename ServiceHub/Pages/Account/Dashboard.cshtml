@page
@model DashboardModel
@{
    ViewData["Title"] = "Главная - Личный кабинет";
    Layout = "_ProfileLayout";
}

<div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 glass-title">Обзор активности</h1>
    </div>

    <!-- Градиентные кубики статистики -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-xl-3">
            <div class="glass-card dashboard-stat-card p-4 h-100" style="background: linear-gradient(135deg, #198754, #0d6efd); color: white; min-width: 145px; max-width: 100%;">
                <h6 class="card-title mb-2">Подтверждено</h6>
                <h3 class="card-text mb-0 fw-bold">@Model.ActiveRequests</h3>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="glass-card dashboard-stat-card p-4 h-100" style="background: linear-gradient(135deg, #ffc107, #fd7e14); color: #212529; min-width: 145px; max-width: 100%;">
                <h6 class="card-title mb-2">На согласовании</h6>
                <h3 class="card-text mb-0 fw-bold">@Model.PendingRequests</h3>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="glass-card dashboard-stat-card p-4 h-100" style="background: linear-gradient(135deg, #0dcaf0, #6610f2); color: white; min-width: 145px; max-width: 100%;">
                <h6 class="card-title mb-2">Завершено</h6>
                <h3 class="card-text mb-0 fw-bold">@Model.CompletedRequests</h3>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="glass-card dashboard-stat-card p-4 h-100" style="background: linear-gradient(135deg, #475569, #1e293b); color: white; min-width: 145px; max-width: 100%;">
                <h6 class="card-title mb-2">Всего заявок</h6>
                <h3 class="card-text mb-0 fw-bold">@Model.TotalRequests</h3>
            </div>
        </div>
    </div>
    <div class="glass-container p-4">
        <h5 class="fw-bold mb-3">Последняя активность</h5>
        @if (Model.RecentRequests.Any())
        {
            <div class="row g-3">
                @foreach (var request in Model.RecentRequests)
                {
                    <div class="col-md-6">
                        <div class="glass-card p-3 h-100">
                            <div class="d-flex flex-wrap align-items-start justify-content-between mb-2 gap-2">
                                <span class="badge badge-glass
                                    @(request.ServiceType == "Транспорт" ? "bg-info text-white" :
                                    request.ServiceType == "Помещения" ? "bg-primary" : "bg-secondary")">
                                    @(request.ServiceType == "Транспорт" ? "🚗 Транспорт" : "🏢 Помещения")
                                </span>
                        <span class="badge badge-glass
                            @(request.Status == "На согласовании" ? "bg-warning text-dark" :
                            request.Status == "Подтверждена" ? "bg-success" :
                            request.Status == "Завершена" ? "bg-info text-dark" :
                            request.Status == "Отклонена" ? "bg-danger" : "bg-secondary")">
                            @request.Status
                        </span>
                            </div>
                            <h6 class="fw-bold">@request.Title</h6>
                            <small style="color: var(--text-muted)">@request.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                        </div>
                    </div>
            }
            </div>
        }
        else
        {
            <p style="color: var(--text-muted)">Активных уведомлений пока нет</p>
        }
    </div>
</div>