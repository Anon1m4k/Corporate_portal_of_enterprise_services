@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Смена пароля";
    Layout = "_ProfileLayout";
}

@if (TempData["PasswordChangeSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["PasswordChangeSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<div class="card shadow-lg rounded-4">
    <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 fw-bold text-primary">Смена пароля</h1>
            </div>

            <form method="post" class="mt-3">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="col-md-6 mb-3">
            <label asp-for="Input.CurrentPassword" class="form-label fw-bold">Текущий пароль</label>
            <input asp-for="Input.CurrentPassword" type="password" class="form-control" />
            <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
            <label asp-for="Input.NewPassword" class="form-label fw-bold">Новый пароль</label>
            <input asp-for="Input.NewPassword" type="password" class="form-control" />
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
            <label asp-for="Input.ConfirmPassword" class="form-label fw-bold">Подтверждение пароля</label>
            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="fas fa-sync-alt me-2"></i>Сменить пароль</button>
            </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}