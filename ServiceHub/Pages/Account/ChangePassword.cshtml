@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Смена пароля";
    Layout = "_ProfileLayout";
}

@if (TempData["PasswordChangeSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["PasswordChangeSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3">
    <h1 class="h2 section-title">Смена пароля</h1>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card border-0 shadow-xl rounded-4 fade-in">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-medium"><i class="fas fa-lock me-2"></i>Текущий пароль</label>
                        <input asp-for="CurrentPassword" type="password" class="form-control rounded-16" />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-medium"><i class="fas fa-key me-2"></i>Новый пароль</label>
                        <input asp-for="NewPassword" type="password" class="form-control rounded-16" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-medium"><i class="fas fa-check-double me-2"></i>Подтверждение пароля</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control rounded-16" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="fas fa-sync-alt me-2"></i>Сменить пароль</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}